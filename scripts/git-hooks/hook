#!/bin/sh
# Global git hook, installed under every hook name by install.sh (core.hooksPath replaces each repo's .git/hooks,
# so this first runs the repo's own hook to keep git-lfs and friends working).
# On post-commit it also sends the commit to VBoards, which checks it off on the matching Planning day card.
name=$(basename "$0")
local_hook="$(git rev-parse --git-common-dir)/hooks/$name"

if [ "$name" != "post-commit" ]; then
    [ -x "$local_hook" ] && exec "$local_hook" "$@"
    exit 0
fi

[ -x "$local_hook" ] && "$local_hook" "$@"

url=$(git config vboards.url)
token=$(git config vboards.token)
[ -n "$url" ] && [ -n "$token" ] || exit 0

git_dir=$(git rev-parse --git-dir)
# Rebases replay commits that were already logged
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] && exit 0

# Per-repo override when the folder name doesn't match the card: git config vboards.card "PostsBuilder"
card=$(git config vboards.card || basename "$(git rev-parse --show-toplevel)")

# Message goes through stdin: curl.exe on Windows re-encodes argv to the ANSI codepage and mangles accents.
# Background + no output so the commit never waits on the network.
git log -1 --format=%s | curl -s -m 15 -o /dev/null -X POST "$url" \
    -H "Authorization: Bearer $token" \
    --data-urlencode "repo=$card" \
    --data-urlencode "email=$(git log -1 --format=%ae)" \
    --data-urlencode "message@-" >/dev/null 2>&1 &
exit 0
